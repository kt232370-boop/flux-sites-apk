{
  "entities": {
    "SiteProject": {
      "title": "SiteProject",
      "description": "An AI-generated website project owned by a user, including HTML source, subdomain, and Firebase hosting status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the site owner."
        },
        "title": {
          "type": "string",
          "description": "Display title of the website project."
        },
        "prompt": {
          "type": "string",
          "description": "Original AI generation prompt describing the site."
        },
        "category": {
          "type": "string",
          "enum": ["landing", "portfolio", "saas", "store", "blog"],
          "description": "Site archetype category."
        },
        "htmlContent": {
          "type": "string",
          "description": "Complete responsive HTML5/CSS3/JS source generated by Gemini."
        },
        "summary": {
          "type": "string",
          "description": "Short summary of the generated site layout and sections."
        },
        "subdomain": {
          "type": "string",
          "description": "Lowercase URL slug for the fluxsites.app hosting endpoint."
        },
        "hostingTier": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"],
          "description": "Hosting tier assigned to this site."
        },
        "deployStatus": {
          "type": "string",
          "enum": ["draft", "deployed"],
          "description": "Current deployment state."
        },
        "deployedUrl": {
          "type": "string",
          "description": "Live or staged hosting URL for the deployed site."
        },
        "customDomain": {
          "type": "string",
          "description": "Optional custom domain linked under Pro or Enterprise hosting."
        },
        "sslEnabled": {
          "type": "boolean",
          "description": "Whether automated TLS/SSL certificate provisioning is active."
        },
        "deployCount": {
          "type": "integer",
          "description": "Total number of deployments published for this site."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "title",
        "prompt",
        "category",
        "htmlContent",
        "summary",
        "subdomain",
        "hostingTier",
        "deployStatus",
        "deployedUrl",
        "customDomain",
        "sslEnabled",
        "deployCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeploymentRecord": {
      "title": "DeploymentRecord",
      "description": "Immutable-origin audit log entry for a site deployment and optional Google Pay checkout.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the owner."
        },
        "siteId": {
          "type": "string",
          "description": "Identifier of the deployed SiteProject document."
        },
        "siteTitle": {
          "type": "string",
          "description": "Title of the deployed site at publish time."
        },
        "deployedUrl": {
          "type": "string",
          "description": "Published hosting endpoint URL."
        },
        "hostingTier": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"],
          "description": "Hosting tier active during deployment."
        },
        "paymentOrderId": {
          "type": "string",
          "description": "Google Pay transaction/order reference if paid at deploy."
        },
        "amountUsdCents": {
          "type": "integer",
          "description": "Amount charged in USD cents (0 for free deploys)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "rolled_back"],
          "description": "Deployment lifecycle state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server deployment timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "siteId",
        "siteTitle",
        "deployedUrl",
        "hostingTier",
        "paymentOrderId",
        "amountUsdCents",
        "status",
        "createdAt"
      ]
    },
    "HostingSubscription": {
      "title": "HostingSubscription",
      "description": "User hosting subscription plan activated via Google Pay.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the subscriber."
        },
        "planId": {
          "type": "string",
          "enum": ["starter_free", "pro_monthly", "enterprise_monthly"],
          "description": "Identifier of the subscribed hosting plan."
        },
        "planName": {
          "type": "string",
          "description": "Human-readable name of the hosting plan."
        },
        "priceUsdCents": {
          "type": "integer",
          "description": "Monthly price in USD cents."
        },
        "currencyCode": {
          "type": "string",
          "enum": ["USD"],
          "description": "ISO 4217 currency code."
        },
        "paymentNetwork": {
          "type": "string",
          "description": "Card network or payment method label returned by Google Pay."
        },
        "paymentTokenSummary": {
          "type": "string",
          "description": "Masked token summary or Google Pay receipt reference."
        },
        "status": {
          "type": "string",
          "enum": ["active", "cancelled"],
          "description": "Subscription status."
        },
        "customDomainsLimit": {
          "type": "integer",
          "description": "Maximum number of custom domains allowed."
        },
        "bandwidthGb": {
          "type": "integer",
          "description": "Monthly CDN bandwidth allowance in GB."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "planId",
        "planName",
        "priceUsdCents",
        "currencyCode",
        "paymentNetwork",
        "paymentTokenSummary",
        "status",
        "customDomainsLimit",
        "bandwidthGb",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/sites/{siteId}": {
      "schema": {
        "$ref": "#/entities/SiteProject"
      },
      "description": "User-owned AI-generated website projects."
    },
    "/users/{userId}/deployments/{deploymentId}": {
      "schema": {
        "$ref": "#/entities/DeploymentRecord"
      },
      "description": "User-owned deployment history records."
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": {
        "$ref": "#/entities/HostingSubscription"
      },
      "description": "User-owned Google Pay hosting subscriptions."
    }
  }
}
